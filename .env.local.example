# Copy this file to .env.local and adjust if needed.
# The app supports two backends, chosen by MODEL_PROVIDER.

# ----------------------------------------------------------------------------
# Which backend to use: "ollama" (local) or "google" (hosted free API).
# Defaults to "ollama". In Codespaces this is set to "google" automatically
# via .devcontainer/devcontainer.json.
# ----------------------------------------------------------------------------
MODEL_PROVIDER=ollama

# ============================================================================
# Option A: LOCAL via Ollama (MODEL_PROVIDER=ollama)  -- default
# ============================================================================
# Base URL of your local Ollama server's API.
# Use 127.0.0.1 (not localhost): on Windows, Node may resolve "localhost" to
# IPv6 ::1 while Ollama listens on IPv4 127.0.0.1, causing connection refused.
OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# The model tag pulled in Ollama. Gemma 4 E2B (text + image + audio, edge size).
# Pull it first with:  ollama pull gemma4:e2b
MODEL_NAME=gemma4:e2b

# Audio input is experimental and only works on the local Ollama edge models.
# Set to "false" to strip audio attachments before they reach the model.
ENABLE_AUDIO=true

# ============================================================================
# Option B: HOSTED via Google's free API (MODEL_PROVIDER=google)
# ============================================================================
# 1) Set MODEL_PROVIDER=google above.
# 2) Get a free API key at https://aistudio.google.com and set it here
#    (in Codespaces, store it as a Codespaces secret instead of committing it).
# GOOGLE_GENERATIVE_AI_API_KEY=key
#
# 3) Pick a hosted model. gemma-4-31b-it is top-quality (text + image, no audio).
# MODEL_NAME=gemma-4-31b-it
#
# Note: hosted Gemma has no audio, so audio is auto-disabled when provider=google.